# Optionnel : copie ce fichier en ".env" pour changer les réglages par défaut.
# IA Gemini (par défaut si la clé est présente) : clé gratuite sur https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
# AI_PROVIDER=gemini   # ou ollama
# HOST=0.0.0.0         # sur le serveur : admin accessible depuis le réseau local / Tailscale
# OLLAMA_MODEL=qwen3-vl:8b
# OLLAMA_REFLEXION=1   # plus précis mais ~4x plus lent
# OLLAMA_URL=http://127.0.0.1:11434
# PORT=3000
